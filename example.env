# Wolfx WebSocket endpoint override. Keep empty to connect WOLFX_SOURCES via WOLFX_WS_BASE.
# Set these to the host user that owns data/ and bark-data/.
PUID=1000
PGID=1000

WOLFX_WS_URL=
WOLFX_WS_BASE=wss://ws-api.wolfx.jp
WOLFX_SOURCES=sc_eew,cq_eew,cenc_eew,cenc_eqlist,jma_eew
# Optional HTTP proxy used only by WebSocket data sources.
# EEW_WEBSOCKET_PROXY=http://host.docker.internal:7890
WOLFX_LISTENER_ENABLED=1

# Global major earthquake source. EMSC/SeismicPortal sends new and updated events by WebSocket.
GLOBAL_QUAKE_LISTENER_ENABLED=1
GLOBAL_QUAKE_SOURCE_URL=wss://www.seismicportal.eu/standing_order/websocket
GLOBAL_QUAKE_MIN_MAGNITUDE=7.0
GLOBAL_FAR_ALERT_ENABLED=1
SOURCE_HEALTH_ALERT_ENABLED=1
SOURCE_HEALTH_ALERT_AFTER_MINUTES=60

ALERT_RED_INTENSITY=4
ALERT_YELLOW_INTENSITY=2
BARK_RED_LEVEL=critical
BARK_RED_VOLUME=10
BARK_RED_SOUND=alarm
BARK_RED_REPEAT=1
BARK_RED_REPEAT_GAP_SECONDS=0
BARK_YELLOW_LEVEL=critical
BARK_YELLOW_VOLUME=6
BARK_YELLOW_SOUND=alarm
BARK_YELLOW_REPEAT=1
BARK_YELLOW_REPEAT_GAP_SECONDS=0
BARK_BLUE_LEVEL=active
BARK_BLUE_VOLUME=
BARK_BLUE_SOUND=
BARK_BLUE_REPEAT=1
BARK_BLUE_REPEAT_GAP_SECONDS=0

EEW_MAX_EVENTS=2000
EEW_MAX_DECISIONS=5000
EEW_MAX_PUSHES=2000

# Internal Bark server URL used by the EEW backend inside docker compose.
BARK_BASE_URL=http://bark-server:18762

# Built-in API password fallback. Use Cloudflare Access, VPN, or reverse-proxy auth for public exposure.
# When set, the web UI asks for this token and all APIs except /api/health require it.
EEW_AUTH_TOKEN=

# Optional external URL opened from Bark notifications.
PUBLIC_BASE_URL=
# Optional publicly reachable icon URL for Bark. With the bundled Bark gateway,
# use your own Bark hostname followed by /eew-icon.png.
# The web UI always uses the bundled /static/eew-icon.png.
PUSH_ICON_URL=https://bark.example.com/eew-icon.png

# Hosts allowed to embed the UI, for example Home Assistant.
# Keep 'self' and append the exact HTTPS origin when needed.
EEW_FRAME_ANCESTORS='self'

# Map tiles are fetched and cached by the backend so browsers do not contact the provider directly.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Optional. Defaults to EEW_WEBSOCKET_PROXY in Docker Compose.
# MAP_HTTP_PROXY=http://host.docker.internal:7890
EEW_MAP_CACHE_MAX_FILES=5000
EEW_BACKUP_RETENTION_DAYS=14

EEW_DATA_DIR=/data

EEW_HUB_PORT=18761
BARK_HOST_PORT=18762
# Defaults only expose ports on this host. Set to 0.0.0.0 only for trusted LAN access.
EEW_BIND_ADDRESS=127.0.0.1
BARK_BIND_ADDRESS=127.0.0.1

# Optional Cloudflare Zero Trust tunnel token.
# Example public hostnames:
# - eew.example.com  -> http://eew-hub:18761
# - bark.example.com -> http://bark-server:18762
CLOUDFLARED_TOKEN=
